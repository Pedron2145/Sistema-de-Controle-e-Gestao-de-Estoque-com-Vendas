{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ERP Basic",
  "version": "0.1.0",
  "identifier": "com.perseverance.erpbasic",
  "build": {
    "frontendDist": "../inventario/dist",
    "devUrl": "http://127.0.0.1:4173/",
    "beforeDevCommand": "npm --prefix ./inventario run dev -- --host 127.0.0.1 --port 4173",
    "beforeBuildCommand": "npm --prefix ./inventario run build"

  },
  "app": {
    "windows": [
      {
        "title": "ERPBasic",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
